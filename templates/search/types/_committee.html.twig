<h2 class="title is-5">
    <a href="{{ result.url}}" data-search-main-link>{{ result.naam }}</a>
</h2>
{% if result.search_match_reason == 'committee_member_match' %}
    <p class="subtitle is-7 match-reason">{{ __('%s is a member of this committee')|format(
        '<a href="%s">%s</a>'|format(
            path('profile.member', {id: result.search_match_committee_member_id}),
            result.search_member.full_name|e('html')))|raw }}</p>
{% else %}
    <p class="subtitle is-7">
        {% if result.type == constant('App\\DataModel\\DataModelCommissie::TYPE_COMMITTEE') %}
            {{ __('Committee') }}
        {% elseif result.type == constant('App\\DataModel\\DataModelCommissie::TYPE_SOCIETY') %}
            {{ __('Society') }}
        {% elseif result.type == constant('App\\DataModel\\DataModelCommissie::TYPE_WORKING_GROUP') %}
            {{ __('Working group') }}
        {% else %}
            {{ __('Group') }}
        {% endif %}
    </p>
{% endif %}
<div class="content">
    {{ result.summary }}
</div>
